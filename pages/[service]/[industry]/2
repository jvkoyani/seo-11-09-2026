                className="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition"
              >
                Contact Us Today
              </Link>
            </div>
          </div>
        </section>
      </main>
    </>
  );
}

export async function getStaticPaths() {
  const services = loadServices();
  const industries = loadIndustries();
  const locations = loadLocations();

  // Seed set: top 100 combinations for initial build
  const paths = [];
  for (let i = 0; i < Math.min(services.length, 5); i++) {
    for (let j = 0; j < Math.min(industries.length, 10); j++) {
      for (let k = 0; k < Math.min(locations.length, 2); k++) {
        paths.push({
          params: {
            service: services[i].slug,
            industry: industries[j].slug,
            location: locations[k].slug,
          },
        });
      }
    }
  }

  return {
    paths,
    fallback: 'blocking',
  };
}

export async function getStaticProps({ params }) {
  const service = getServiceBySlug(params.service);
  const industry = getIndustryBySlug(params.industry);
  const location = getLocationBySlug(params.location);

  if (!service || !industry || !location) {
    return { notFound: true };
  }

  const canonical = generateCanonical(
    `/${service.slug}/${industry.slug}/${location.slug}`
  );

  const serviceSchema = generateServiceSchema(service.name);
  const localSchema = generateLocalBusinessSchema(location.name, location.state);
  const breadcrumbSchema = generateBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: service.name, url: `/${service.slug}` },
    { name: industry.name, url: `/${service.slug}/${industry.slug}` },
    {
      name: location.name,
      url: `/${service.slug}/${industry.slug}/${location.slug}`,
    },
  ]);

  const schemas = serializeSchemas([serviceSchema, localSchema, breadcrumbSchema]);

  return {
    props: {
      service,
      industry,
      location,
      canonical,
      schemas,
    },
    revalidate: 86400,
  };
}
