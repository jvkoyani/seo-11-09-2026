        <section className="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16 md:py-24">
          <div className="container mx-auto px-4">
            <h1 className="text-4xl md:text-5xl font-bold mb-6 leading-tight">{title}</h1>
            <p className="text-xl text-blue-100 max-w-2xl">{description}</p>
            <button className="mt-8 bg-white text-blue-600 px-8 py-3 rounded-lg font-bold hover:bg-gray-100 transition text-lg">
              Get Free Consultation
            </button>
          </div>
        </section>

        <section className="py-16 md:py-24">
          <div className="container mx-auto px-4 max-w-3xl">
            <h2 className="text-3xl font-bold text-gray-900 mb-6">About Our {service.name} Services</h2>
            <p className="text-gray-700 text-lg mb-4">{service.description}</p>

            <h3 className="text-2xl font-bold text-gray-900 mt-12 mb-4">Why Choose Us for {industry.name}?</h3>
            <p className="text-gray-700 text-lg mb-6">{industry.description}</p>

            <h3 className="text-2xl font-bold text-gray-900 mt-12 mb-4">Our {location.name} Presence</h3>
            <p className="text-gray-700 text-lg">
              We're proud to serve businesses throughout {location.name}, {location.state}. Our team understands
              the unique needs of the local market and delivers customized solutions for maximum impact.
            </p>

            <div className="mt-12 pt-12 border-t border-gray-200">
              <Link
